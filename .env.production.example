# ---------------------------------------------------------------------------
# Production environment - copy to .env.production on the server.
#
#   cp .env.production.example .env.production
#
# Never commit the filled-in file. DATABASE_URL and REDIS_URL are NOT set here:
# docker-compose.prod.yml supplies them with in-network hostnames, because the
# published 3307/6380 ports are a local-development convenience only.
# ---------------------------------------------------------------------------

# --- Host -------------------------------------------------------------------
# Bare domain pointed at this server's public IP with an A record. Caddy
# provisions TLS for it automatically, so no certificate work is needed.
DOMAIN=scheduler.example.com

# --- Database credentials (consumed by the mysql service) -------------------
# Generate each with: openssl rand -base64 24
MYSQL_ROOT_PASSWORD=replace-me
MYSQL_DATABASE=reachinbox
MYSQL_USER=reachinbox
MYSQL_PASSWORD=replace-me

# --- Worker & throughput ----------------------------------------------------
WORKER_CONCURRENCY=5
MIN_DELAY_MS_BETWEEN_SENDS=2000
MAX_EMAILS_PER_HOUR_PER_SENDER=200
MAX_EMAILS_PER_HOUR=1000
RATE_LIMIT_MODE=per-sender
SENDER_POOL_SIZE=3

# Must be 0 in production. Any other value randomly fails real sends.
SIMULATE_SMTP_FAILURE_RATE=0

# --- Auth -------------------------------------------------------------------
# NEXTAUTH_URL is derived from DOMAIN by the compose file; do not set it here.
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=replace-me

# A SEPARATE Google OAuth client from the local one. Its authorised redirect
# URI must be exactly:  https://<DOMAIN>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Deployment shape -------------------------------------------------------
# Free hosts often only offer web services, not background workers. Setting
# this true runs the BullMQ worker inside the API process so one service does
# both. Leave false when the worker has its own service (docker-compose.prod).
RUN_WORKER_IN_API=false
