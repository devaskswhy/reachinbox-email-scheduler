# ---------------------------------------------------------------------------
# ReachInbox Scheduler - environment reference
# Copy to .env and adjust. Never commit the populated .env.
# ---------------------------------------------------------------------------

# --- Datastores -------------------------------------------------------------
# MySQL connection string. Matches the mysql service in docker-compose.yml.
DATABASE_URL="mysql://reachinbox:reachinbox@localhost:3307/reachinbox"

# Redis connection string, used as the BullMQ backing store.
REDIS_URL="redis://localhost:6380"

# --- Backend API ------------------------------------------------------------
# Port the Express API listens on.
PORT=4001

# --- Worker & throughput ----------------------------------------------------
# How many jobs a single worker process handles in parallel.
WORKER_CONCURRENCY=5

# Minimum spacing between two consecutive sends, in milliseconds. Guards
# against bursts that look like spam to receiving mail servers.
MIN_DELAY_MS_BETWEEN_SENDS=1000

# Hard ceiling on emails a single sender account may send per rolling hour.
MAX_EMAILS_PER_HOUR_PER_SENDER=100

# How the limiter is enforced: "global" applies one shared bucket across all
# senders; "per_sender" gives each sender its own independent bucket.
RATE_LIMIT_MODE=per_sender

# Number of sender accounts jobs are distributed across.
SENDER_POOL_SIZE=3

# --- Auth (NextAuth, frontend) ----------------------------------------------
# Canonical URL of the frontend; must match the OAuth redirect origin.
NEXTAUTH_URL="http://localhost:3001"

# Secret used to sign session cookies and JWTs.
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-me-with-a-random-32-byte-secret"

# Google OAuth credentials from the Google Cloud console.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- Frontend ---------------------------------------------------------------
# Backend base URL. NEXT_PUBLIC_ prefix exposes it to the browser bundle,
# so it must never hold a secret.
NEXT_PUBLIC_BACKEND_URL="http://localhost:4001"
